# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
devtools_options.yaml

# Symbolication relatedx    
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output
/android/build/
/android/app/build/
/android/.gradle/

# Environment files
.env
.env.*

# Android signing
android/key.properties
*.jks
*.keystore

# Local configuration
android/local.properties
# Documentation
*.pdf
*.docx

# ...except bundled app assets (e.g. the sample PDF used for the in-app
# document preview demo), which need to be tracked.
!assets/**/*.pdf
